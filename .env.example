# Public base URL used to build share and reward links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development defaults to JSON when omitted.
# Production MUST use postgres and will fail fast otherwise.
VIRALIO_PERSISTENCE=json

# Required when VIRALIO_PERSISTENCE=postgres.
# Compatible with standard PostgreSQL / Supabase connection strings.
DATABASE_URL=

# Secure merchant sessions and persisted merchant PIN derivation.
# In production VIRALIO_AUTH_SECRET must contain at least 32 characters.
VIRALIO_AUTH_SECRET=replace-with-at-least-32-random-characters

# Protects /alta and the merchant provisioning + Brand AI preview endpoints.
# Use a separate random value; in production it must contain at least 24 characters.
VIRALIO_ONBOARDING_KEY=replace-with-a-separate-random-onboarding-key

# OpenAI Brand Engine. Server-side only: never use NEXT_PUBLIC_ for this key.
# ChatGPT proposes a brand profile once during onboarding; consumer traffic does not call OpenAI.
OPENAI_API_KEY=
OPENAI_BRAND_MODEL=gpt-5.6-terra

# Football Simulator backend. Optional while the Viralio local Monte Carlo fallback is active.
# Example: https://football-simulator.example.com
FOOTBALL_SIMULATOR_API_URL=

# Legacy/configured demo merchants only: slug -> numeric PIN (4-12 digits).
# Merchants created from /alta keep their PIN credentials in merchant_accounts as scrypt hashes.
VIRALIO_MERCHANT_PINS={"moka":"000000","atlas-barber":"000000"}


# Optional reverse proxy for Maurilio.
# Must be an HTTPS origin only (no path/trailing slash). If omitted or invalid,
# Viralio serves no /maurilio proxy and production behavior remains unchanged.
MAURILIO_ORIGIN=


# ANUNCIOS QUE VENDEN - automated Mercado Pago delivery.
# Server-side only. The checkout route falls back to the legacy payment link while this is empty.
MERCADOPAGO_ACCESS_TOKEN=
# Optional but recommended: secret generated by Mercado Pago when configuring Webhooks.
MERCADOPAGO_WEBHOOK_SECRET=

# Optional transactional email. Access still works through the post-payment return without email.
RESEND_API_KEY=
# Example after verifying a sending domain: Viralio <ventas@viralio.net>
EBOOK_EMAIL_FROM=
